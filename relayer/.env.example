# Testnet key only. Never commit a real key, and never use a key that holds mainnet funds.
RELAYER_PRIVATE_KEY=
# Path to the pinned verification_key.json from the circuits-pinned-v1 release.
RELAYER_VKEY=circuits/pinned/verification_key.json
PORT=8787
# Fee taken from the shielded amount, in wei. 0.001 ETH by default.
RELAYER_FEE_WEI=1000000000000000
# The relayer pauses when the network gas price is above this, in wei.
RELAYER_MAX_GAS_WEI=20000000000
RELAYER_ASSUMED_GAS=2000000
