# Devnet and testnet only. Mainnet endpoints are rejected at startup.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional. Solana CLI JSON byte array, or 128 hex characters. Never commit a real key.
# SOLANA_KEYPAIR=
# Program id from `solana program deploy` on devnet. Defaults to the local test id.
# SHADE_SOLANA_PROGRAM_ID=
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# NEAR_ACCOUNT_ID=alice.testnet
# NEAR_CONTRACT_ID=shade.testnet
# NEAR_PRIVATE_KEY=ed25519:...
# Robinhood Chain testnet (Arbitrum Orbit). Not the broker API.
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=46630
# ROBINHOOD_POOL=0x...
# ROBINHOOD_PRIVATE_KEY=0x...
# Loopback only. The adapter does not submit. Canton records attestor signatures, not proofs.
CANTON_HOST=http://127.0.0.1:5000
