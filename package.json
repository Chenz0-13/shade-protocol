{
  "name": "shade-protocol",
  "version": "0.1.0",
  "description": "Shader Protocol devnet SDK for shielded notes. The npm package name is still shade-protocol.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:app": "tsc -p app/tsconfig.json --noEmit && vite build --config app/vite.config.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "relayer": "node dist/relayer/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "circuit:setup": "node scripts/setup-circuit.mjs",
    "smoke": "node scripts/smoke-deployment.mjs",
    "audit": "npm audit --audit-level=high",
    "security:circomspect": "node scripts/security/circomspect.mjs",
    "security:constraints": "node scripts/security/constraints.mjs",
    "security:prover": "node scripts/malicious-prover.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3",
    "circomlib": "^2.0.5",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "underscore": "1.13.8"
  }
}
